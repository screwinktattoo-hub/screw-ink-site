:root {
  --bg: #0b0b0b;
  --fg: #f5f5f5;
  --muted: #9a9a9a;
  --border: #2a2a2a;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--fg);
  font-family: Helvetica, Arial, sans-serif;
}

header {
  text-align: center;
  padding: 3rem 1.5rem 2rem;
}

header h1 {
  font-size: 2.2rem;
  font-weight: 400;
  margin: 0;
}

header p {
  margin-top: 0.5rem;
  color: var(--muted);
  font-size: 0.9rem;
}

main {
  max-width: 1200px;
  margin: auto;
  padding: 1.5rem;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1.5rem;
}

.flash {
  border: 1px solid var(--border);
  padding: 0.75rem;
  background: #111;
}

.flash img {
  width: 100%;
  display: block;
  margin-bottom: 0.75rem;
  filter: grayscale(100%);
}

.flash h3 {
  font-size: 0.9rem;
  font-weight: 400;
  margin: 0 0 0.25rem;
}

.meta {
  font-size: 0.75rem;
  color: var(--muted);
  line-height: 1.4;
}

.status {
  display: inline-block;
  margin-top: 0.5rem;
  font-size: 0.7rem;
  padding: 0.2rem 0.5rem;
  border: 1px solid var(--border);
  color: var(--fg);
}

.book {
  display: block;
  margin-top: 0.75rem;
  text-align: center;
  padding: 0.4rem;
  font-size: 0.75rem;
  color: var(--fg);
  border: 1px solid var(--fg);
  text-decoration: none;
  transition: background 0.2s;
}

.book:hover {
  background: var(--fg);
  color: var(--bg);
}

footer {
  text-align: center;
  padding: 2rem 1rem;
  font-size: 0.75rem;
  color: var(--muted);
}

footer a {
  color: var(--fg);
  text-decoration: none;
  margin: 0 0.5rem;
