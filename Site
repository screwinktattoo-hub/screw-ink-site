<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Screw_ink — Flash</title>
  <link rel="stylesheet" href="style.css"/>
</head>
<body>
<header>
  <h1>Screw_ink</h1>
  <p>Flash available — first come, first served</p>
</header>

<main>
  <div class="grid" id="flashGrid">
    <!-- Flash loaded dynamically -->
  </div>
</main>

<footer>
  <a href="https://instagram.com/screw_ink" target="_blank">Instagram</a>
  <a href="#">Custom booking</a>
</footer>

<script>
  fetch('flash.json')
    .then(response => response.json())
    .then(data => {
      const grid = document.getElementById('flashGrid');
      data.forEach(flash => {
        const div = document.createElement('div');
        div.className = 'flash';
        div.innerHTML = `
          <img src="flash/${flash.image}" alt="${flash.name}">
          <h3>${flash.name}</h3>
          <div class="meta">Size: ${flash.size}<br>Price: ${flash.price}</div>
          <div class="status">${flash.status}</div>
          <a class="book" href="booking.html" target="_blank">Book this flash</a>
        `;
        grid.appendChild(div);
      });
    });
</script>

</body>
</html>
